# Copy to .env.local and fill in. Every value here is NEXT_PUBLIC_ (safe to expose in the browser).
# Reuno has no server secrets today: it never holds private keys and never signs for users.

# Robinhood Chain RPC used by the site to read prices, balances, simulate and estimate gas.
# Official public RPC (rate-limited): https://docs.robinhood.com/chain/connecting
# For production, point this at a provider URL (e.g. Alchemy's Robinhood endpoint). Wallets are always
# given the official public RPC when adding the network, never this value.
NEXT_PUBLIC_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com/

# Official block explorer: https://docs.robinhood.com/chain/add-network-to-wallet
NEXT_PUBLIC_RH_EXPLORER_URL=https://robinhoodchain.blockscout.com

# WalletConnect (Reown) project id from https://cloud.reown.com. Leave empty to offer browser wallets only;
# the WalletConnect option is then hidden and a warning is logged in development.
# Add your production domain (the same as NEXT_PUBLIC_SITE_URL) to the project's domain allowlist.
NEXT_PUBLIC_WC_PROJECT_ID=

# Public site URL: used for page metadata and as the WalletConnect metadata url (must match the allowlist).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
