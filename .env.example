# Robinhood Chain (official values: https://docs.robinhood.com/chain/add-network-to-wallet)
NEXT_PUBLIC_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
NEXT_PUBLIC_RH_EXPLORER_URL=https://robinhoodchain.blockscout.com

# WalletConnect Cloud project id (https://cloud.reown.com). Leave empty to offer injected wallets only.
NEXT_PUBLIC_WC_PROJECT_ID=

# Public site URL used for metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
